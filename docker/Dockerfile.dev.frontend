# =============================================================================
# AssoInCloud — Frontend development Dockerfile
# Runs Next.js dev server with HMR for instant feedback on code changes.
# Source code is mounted at runtime — no rebuild needed.
# =============================================================================
FROM node:20-alpine

WORKDIR /app

# Copy package manifests first for dependency caching
COPY apps/frontend/package.json apps/frontend/package-lock.json ./

# Install dependencies (cached layer — only re-runs if package.json changes)
RUN npm ci --legacy-peer-deps

# Copy source code (will be overridden by volume mount at runtime)
COPY apps/frontend/ .

EXPOSE 3000

# Next.js dev server with HMR — listens on all interfaces
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
