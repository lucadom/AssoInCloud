# =============================================================================
# AssoInCloud — Backend development Dockerfile
# Runs Spring Boot with devtools for automatic restart on code changes.
# Source code is mounted at runtime — no rebuild needed.
# =============================================================================
FROM eclipse-temurin:25-jdk-jammy

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Maven wrapper and POM first for dependency caching
COPY apps/backend/mvnw apps/backend/mvnw.cmd ./
COPY apps/backend/.mvn .mvn
COPY apps/backend/pom.xml .

# Download dependencies (cached layer — only re-runs if pom.xml changes)
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B

# Copy source code (will be overridden by volume mount at runtime)
COPY apps/backend/src src

# Create data directory
RUN mkdir -p /data

EXPOSE 8080

# Run Spring Boot in dev mode with devtools enabled.
# Shell form is required so that ${ASSOINCLOUD_DB_PATH} is expanded at runtime.
CMD ./mvnw spring-boot:run \
    -Dspring-boot.run.jvmArguments="-DASSOINCLOUD_DB_PATH=${ASSOINCLOUD_DB_PATH}"
